# Shared production env for the backend and frontend.
# Copy to `.env.production` on the EC2 host and replace placeholder values.

# Backend
NODE_ENV=production
PORT=4000
TRUST_PROXY=1
FRONTEND_URL=https://app.example.com
API_URL=http://localhost:4000
DATABASE_URL=postgresql://logiclab:StrongPassword@localhost:5432/logiclab?schema=public
JWT_ACCESS_SECRET=replace_with_a_32_char_plus_secret
ENCRYPTION_KEY=replace_with_a_32_char_plus_secret
COOKIE_SECURE=true

# AI
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=replace_if_using_gemini
GROQ_API_KEY=

# Auth / Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Mail
RESEND_API_KEY=
EMAIL_FROM=LogicLab <onboarding@resend.dev>

# Redis / rate limits
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# AWS / storage (optional, if using S3-compatible R2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Frontend
API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=https://app.example.com
